{
  "schema": 3,
  "title": "Between the Markers",
  "statement": "## Task\nReturn whether `value` lies between `left` and `right`, inclusive. The markers may arrive in either order.\n\nImplement `between(value, left, right)`. All arguments are signed 32-bit integers.",
  "difficulty": "easy",
  "tags": [
    "comparisons",
    "scalar"
  ],
  "tests": [
    {
      "args": [
        4,
        2,
        7
      ],
      "expected": true,
      "hidden": false
    },
    {
      "args": [
        9,
        7,
        2
      ],
      "expected": false,
      "hidden": false
    },
    {
      "args": [
        -2147483648,
        2147483647,
        -2147483648
      ],
      "expected": true,
      "hidden": true
    },
    {
      "args": [
        0,
        0,
        0
      ],
      "expected": true,
      "hidden": true
    }
  ],
  "limits": {
    "time_ms": 2000,
    "memory_mib": 256,
    "output_bytes": 1048576
  },
  "interface": {
    "kind": "function",
    "name": "between",
    "params": [
      {
        "name": "value",
        "ty": "int"
      },
      {
        "name": "left",
        "ty": "int"
      },
      {
        "name": "right",
        "ty": "int"
      }
    ],
    "returns": "bool"
  }
}
