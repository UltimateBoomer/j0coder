{
  "schema": 3,
  "title": "Quiet Peaks",
  "statement": "## Task\nGiven an integer array, return the **indices** of elements strictly greater than every existing immediate neighbor. An endpoint has one neighbor. A single element is a peak; an empty array has no peaks. Return indices in increasing order.\n\nFor `[2, 5, 5, 1, 4]`, only index `4` is a peak.",
  "difficulty": "easy",
  "tags": [
    "arrays",
    "iteration"
  ],
  "tests": [
    {
      "args": [
        [
          2,
          5,
          5,
          1,
          4
        ]
      ],
      "expected": [
        4
      ],
      "hidden": false
    },
    {
      "args": [
        []
      ],
      "expected": [],
      "hidden": false
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": [
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          3,
          1,
          4,
          1,
          5
        ]
      ],
      "expected": [
        0,
        2,
        4
      ],
      "hidden": true
    }
  ],
  "limits": {
    "time_ms": 2000,
    "memory_mib": 256,
    "output_bytes": 1048576
  },
  "interface": {
    "kind": "function",
    "name": "quietPeaks",
    "params": [
      {
        "name": "values",
        "ty": {
          "array": "int"
        }
      }
    ],
    "returns": {
      "array": "int"
    }
  }
}
