#include <iostream>
#include <optional>
namespace nlohmann {
template <typename T> struct adl_serializer<std::optional<T>> {
    static void to_json(json& value, const std::optional<T>& item) {
        if (item) value = *item; else value = nullptr;
    }
    static void from_json(const json& value, std::optional<T>& item) {
        if (value.is_null()) item.reset(); else item = value.get<T>();
    }
};
}
